# Copy to .env (gitignored). Only the keys you have; a missing key removes that model from the chain.

# Primary vendor: Claude Sonnet answers, Claude Haiku is the same-vendor fallback and the guard fallback.
ANTHROPIC_API_KEY=
# Cross-vendor fallback (Gemini 2.5 Flash), in config/agent.yaml order. Optional.
GOOGLE_API_KEY=
# TypeSafe Jev decision model for the guardrail. Optional; without it the guard runs on Haiku alone.
TYPESAFE_API_KEY=
# Only if TypeSafe direct is unavailable: Jev through OpenRouter. Optional.
OPENROUTER_API_KEY=

# OpenSky Network registered API client (v6, aircraft currently around an airport). Optional; without it the
# query runs anonymously under OpenSky's 400-credit daily limit.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Hard monthly spend cap in USD, enforced in code before every paid call. Mirror it in each provider console.
BUDGET_USD=15
# SQLite ledger (spend). On Render this is ephemeral unless a disk is attached.
DB_PATH=data/agent.db
# Shared secret for /api/stats and session resets when exposed publicly. Empty = open (local only).
ADMIN_TOKEN=
# Offline demo: every model call is answered by Pydantic AI's TestModel, no key, no spend.
# MODEL_MODE=test

# Data layer
# Contact User-Agent sent to FAA / BTS / OurAirports fetches (faa.gov rejects requests without a browser-like UA).
# FAA_USER_AGENT=airportiq/0.1 (your-contact@example.com)
# SNAPSHOT_DIR=data/snapshots
# Minutes to cache the live FAA NAS status feed (1 min on failure).
# LIVE_CACHE_MIN=10
# Optional tracing (Logfire); no-op when empty.
# LOGFIRE_TOKEN=
